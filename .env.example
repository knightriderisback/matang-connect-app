# Supabase (safe to expose to the browser — protected by RLS)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Service role key — SERVER-SIDE ONLY, never expose to the browser, never
# prefix with NEXT_PUBLIC_. Used only inside API routes (lib/supabase/admin.ts)
# after the user's session cookie has already been verified.
# Get it from: Supabase Dashboard > Project Settings > API > service_role key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Session signing secret — SERVER-SIDE ONLY, never expose to the browser.
# Generate one with: openssl rand -base64 32
# REQUIRED in production — app will refuse to start without it.
APP_SESSION_SECRET=replace-with-a-long-random-value
